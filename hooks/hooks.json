  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/leftoff\" sync --quiet",
            "async": true
          }
        ]
      }
    ]
  }
}
